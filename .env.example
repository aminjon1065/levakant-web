# ─── Site ─────────────────────────────────────────────────────────────────────
# Public URL (canonical, hreflang, sitemap, social preview). Domain to be decided.
NEXT_PUBLIC_SITE_URL=https://example.com
# Search engines may index the site only when set to 1 (keep 0 while prices are demo values).
SITE_INDEXABLE=0

# ─── Owner data (public; applied at build time — rebuild after changes) ──────
# Leave a variable empty and the related button/line is simply not shown. Never put test numbers here.
CONTACT_PHONE=                 # e.g. +992 XX XXX XX XX — sales phone (tel: link)
CONTACT_WHATSAPP=              # verified WhatsApp number, international format — enables all WhatsApp buttons
CONTACT_TELEGRAM=              # Telegram username without @
CONTACT_EMAIL=                 # sales e-mail (mailto: link)
CONTACT_INSTAGRAM=             # Instagram username
CONTACT_FACEBOOK_URL=          # full profile URL
CONTACT_FACEBOOK_LABEL=
CONTACT_OFFICE_RU=             # sales office address, per language
CONTACT_OFFICE_TG=
CONTACT_OFFICE_EN=
CONTACT_HOURS_RU=              # opening hours, per language
CONTACT_HOURS_TG=
CONTACT_HOURS_EN=
MAP_2GIS_URL=                  # only after the plot coordinates are confirmed
MAP_GOOGLE_URL=
DOC_SKETCH_URL=                # published PDFs (otherwise the document shows "pending")
DOC_PERMIT_URL=
DOC_EXPERTISE_URL=
DOC_LAND_URL=
DOC_CONTRACT_URL=
PRIVACY_POLICY_URL=            # required for the enquiry form to accept submissions
CONSTRUCTION_CHANNEL_URL=      # channel with construction photo reports
DEVELOPER_QUOTE_APPROVED=0     # 1 = the developer approved the address shown in "Застройщик"

# ─── Analytics (public; build time). Empty = no tracker is loaded, CSP stays 'self' only ──
# Events: layout_select, layout_share, calc_quote, calc_open_from_card, building_explode, apartment_3d,
# contact_click, lead_submit, lead_error, lang_switch (no names / phones are ever sent).
NEXT_PUBLIC_GA4_ID=            # G-XXXXXXXXXX
NEXT_PUBLIC_YM_ID=             # Yandex Metrika counter number
NEXT_PUBLIC_META_PIXEL_ID=     # Meta Pixel ID

# ─── Enquiries (secret; read at request time, never baked into the build) ─────
# The form works only with at least one channel AND PRIVACY_POLICY_URL.
LEADS_TELEGRAM_BOT_TOKEN=
LEADS_TELEGRAM_CHAT_ID=
LEADS_WEBHOOK_URL=             # CRM / automation endpoint receiving JSON
LEADS_WEBHOOK_SECRET=          # sent as "Authorization: Bearer …"
